Scriptname DevilsC130DoorPanel extends ObjectReference
{One panel of a C-130 jump door (DevilsC130DoorPanel0-4, bottom first). The panels ride the
door's track together: up the wall and round under the ceiling as the door opens, back down as
it closes, through the poses in DevilsC130DoorTrack (generated by make_c130_blockout.py). The
jumpmaster (DevilsJumpmaster) has them listen for his DoorsStow and DoorsSlide events, so all
ten start in the same frame.}

Int Property Panel Auto Const Mandatory
{Which panel, 0 (at the sill) to 4 (the top, with the rounded corners).}

Float ex
Float ey
Float ez
Float heading
Float[] keys

Function Listen(DevilsJumpmaster jm)
	{Called on load, with the panel on its editor spot (the door closed).}
	MoveToMyEditorLocation()
	ex = GetPositionX()
	ey = GetPositionY()
	ez = GetPositionZ()
	heading = GetAngleZ()
	keys = DevilsC130DoorTrack.Keys(Panel)
	RegisterForCustomEvent(jm, "DoorsStow")
	RegisterForCustomEvent(jm, "DoorsSlide")
EndFunction

Event DevilsJumpmaster.DoorsStow(DevilsJumpmaster jm, Var[] args)
	{Closing: shown where the open door lies (it's the same shape), ready to come down.}
	Int last = DevilsC130DoorTrack.Count() - 1
	StopTranslation()
	SetPosition(X(last), Y(last), ez + keys[3 * last + 1])
	SetAngle(0.0, keys[3 * last + 2], heading)
	Enable()
EndEvent

Event DevilsJumpmaster.DoorsSlide(DevilsJumpmaster jm, Var[] args)
	{args: Bool open, Float seconds.}
	Bool open = args[0] as Bool
	Float seconds = args[1] as Float
	Int tries = 0
	While !Is3DLoaded() && tries < 20
		Utility.Wait(0.05)
		tries += 1
	EndWhile
	Int n = DevilsC130DoorTrack.Count()
	Float dt = seconds / (n - 1)
	Int i = 1
	While i < n
		Int j = i
		Int from = i - 1
		If !open
			j = n - 1 - i
			from = j + 1
		EndIf
		Float dx = (keys[3 * j] - keys[3 * from])
		Float dz = (keys[3 * j + 1] - keys[3 * from + 1])
		Float turn = Math.abs(keys[3 * j + 2] - keys[3 * from + 2])
		Float speed = Math.sqrt(dx * dx + dz * dz) / dt
		If speed < 1.0
			speed = 1.0
		EndIf
		Float spin = turn / dt
		If spin < 0.5
			spin = 0.5
		EndIf
		TranslateTo(X(j), Y(j), ez + keys[3 * j + 1], 0.0, keys[3 * j + 2], heading, speed, spin)
		Utility.Wait(dt)
		i += 1
	EndWhile
EndEvent

Float Function X(Int j)
	{Key j's outboard shift, turned with the door's heading (the port door faces the other way).}
	Return ex + keys[3 * j] * Math.cos(heading)
EndFunction

Float Function Y(Int j)
	Return ey - keys[3 * j] * Math.sin(heading)
EndFunction
